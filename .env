import streamlit as st
from openai import OpenAI
from dotenv import load_dotenv
import os


# ==========================================
# LOAD API KEY
# ==========================================

load_dotenv()

api_key = os.getenv("OPENAI_API_KEY")

if api_key:
    client = OpenAI(api_key=api_key)
else:
    client = None


# ==========================================
# PAGE CONFIG
# ==========================================

st.set_page_config(
    page_title="Learnify AI",
    page_icon="📚",
    layout="wide"
)


# ==========================================
# SESSION STATE
# ==========================================

if "page" not in st.session_state:
    st.session_state.page = "home"

if "chapters" not in st.session_state:
    st.session_state.chapters = []


# ==========================================
# AI NOTES FUNCTION
# ==========================================

def generate_notes(topic, subject):

    prompt = f"""
You are Learnify AI, a friendly AI study assistant.

Create study notes for a student.

Subject:
{subject}

Topic:
{topic}

The notes must be:

1. Extremely easy to understand.
2. Written like a smart student making revision notes.
3. Avoid unnecessary complicated language.
4. Explain difficult terms immediately in simple language.
5. Include a simple real-life example wherever useful.
6. Include important points for exams.
7. Include a memory trick whenever possible.
8. Include a short quick-revision section.
9. Organize everything with clear headings and bullet points.
10. Do not write huge paragraphs.
11. Focus on understanding, not just memorizing.

Use this structure:

# Topic Name

## 📌 Simple Meaning

Explain the topic in very simple language.

## 🧠 Understand the Concept

Explain the concept step by step.

## 💡 Example

Give an easy real-life or academic example.

## 🔑 Important Points

Give the most important points.

## 📖 Difficult Words

List difficult terms and explain each in simple language.

Format:

Term → Simple meaning

## 🧠 Memory Trick

Give a useful mnemonic or memory trick if possible.

## 🎯 Exam Points

Give important points that a student should remember for an exam.

## ⚡ Quick Revision

Give a very short revision summary.

Do not mention that you are an AI.
"""

    response = client.responses.create(
        model="gpt-5-mini",
        input=prompt
    )

    return response.output_text


# ==========================================
# HOME PAGE
# ==========================================

if st.session_state.page == "home":

    st.title("📚 Learnify AI")
    st.subheader("Your Personal Study Buddy")

    st.write(
        "Learnify AI helps students understand topics "
        "through simple notes, examples, diagrams and quizzes."
    )

    st.divider()

    if st.button("➕ Add Chapter", use_container_width=True):
        st.session_state.page = "add_chapter"
        st.rerun()

    st.subheader("📖 Your Chapters")

    if len(st.session_state.chapters) == 0:

        st.info(
            "No chapters added yet. "
            "Start by adding your first chapter."
        )

    else:

        for i, chapter in enumerate(st.session_state.chapters):

            if st.button(
                f"📘 {chapter['name']} — {chapter['subject']}",
                key=f"chapter_{i}",
                use_container_width=True
            ):

                st.session_state.current_chapter = i
                st.session_state.page = "chapter"
                st.rerun()


# ==========================================
# ADD CHAPTER
# ==========================================

elif st.session_state.page == "add_chapter":

    st.title("➕ Create New Chapter")

    chapter_name = st.text_input(
        "Chapter Name",
        placeholder="Example: Artificial Intelligence"
    )

    subject = st.text_input(
        "Subject",
        placeholder="Example: Computer Science"
    )

    st.divider()

    col1, col2 = st.columns(2)

    with col1:

        if st.button("← Back", use_container_width=True):

            st.session_state.page = "home"
            st.rerun()

    with col2:

        if st.button(
            "Create Chapter 🚀",
            use_container_width=True
        ):

            if not chapter_name.strip():

                st.error("Please enter a chapter name.")

            elif not subject.strip():

                st.error("Please enter the subject.")

            else:

                new_chapter = {
                    "name": chapter_name,
                    "subject": subject,
                    "topics": []
                }

                st.session_state.chapters.append(
                    new_chapter
                )

                st.session_state.current_chapter = (
                    len(st.session_state.chapters) - 1
                )

                st.session_state.page = "chapter"

                st.rerun()


# ==========================================
# CHAPTER PAGE
# ==========================================

elif st.session_state.page == "chapter":

    index = st.session_state.current_chapter

    chapter = st.session_state.chapters[index]

    st.title(f"📘 {chapter['name']}")

    st.caption(
        f"Subject: {chapter['subject']}"
    )

    st.divider()

    st.subheader("📚 Topics")

    if len(chapter["topics"]) == 0:

        st.info(
            "No topics added yet. "
            "Add your first topic to start learning."
        )

    else:

        for i, topic in enumerate(chapter["topics"]):

            if st.button(
                f"📝 {topic['name']}",
                key=f"topic_{index}_{i}",
                use_container_width=True
            ):

                st.session_state.current_topic = i

                st.session_state.page = "topic"

                st.rerun()

    st.divider()

    if st.button(
        "➕ Add Topic",
        use_container_width=True
    ):

        st.session_state.page = "add_topic"

        st.rerun()

    if st.button(
        "← Back to Chapters",
        use_container_width=True
    ):

        st.session_state.page = "home"

        st.rerun()


# ==========================================
# ADD TOPIC
# ==========================================

elif st.session_state.page == "add_topic":

    index = st.session_state.current_chapter

    chapter = st.session_state.chapters[index]

    st.title("➕ Add Topic")

    st.write(
        f"Chapter: **{chapter['name']}**"
    )

    topic_name = st.text_input(
        "Topic Name",
        placeholder="Example: What is Artificial Intelligence?"
    )

    st.divider()

    if st.button(
        "Add Topic",
        use_container_width=True
    ):

        if not topic_name.strip():

            st.error("Please enter a topic.")

        else:

            chapter["topics"].append(
                {
                    "name": topic_name,
                    "notes": None
                }
            )

            st.session_state.current_topic = (
                len(chapter["topics"]) - 1
            )

            st.session_state.page = "topic"

            st.rerun()

    if st.button("← Back", use_container_width=True):

        st.session_state.page = "chapter"

        st.rerun()


# ==========================================
# TOPIC PAGE
# ==========================================

elif st.session_state.page == "topic":

    chapter_index = st.session_state.current_chapter

    topic_index = st.session_state.current_topic

    chapter = st.session_state.chapters[
        chapter_index
    ]

    topic = chapter["topics"][
        topic_index
    ]

    st.title(f"📝 {topic['name']}")

    st.caption(
        f"Chapter: {chapter['name']}"
    )

    st.divider()

    if not topic["notes"]:

        st.subheader(
            "✨ Ready to learn?"
        )

        st.write(
            "Learnify AI will turn this topic into "
            "simple, student-friendly notes."
        )

        if not api_key:

            st.error(
                "OpenAI API key not found. "
                "Please add OPENAI_API_KEY to your .env file."
            )

        else:

            if st.button(
                "✨ Generate Notes",
                use_container_width=True
            ):

                with st.spinner(
                    "Learnify AI is preparing your notes..."
                ):

                    try:

                        notes = generate_notes(
                            topic["name"],
                            chapter["subject"]
                        )

                        topic["notes"] = notes

                        st.rerun()

                    except Exception as e:

                        st.error(
                            f"Something went wrong: {e}"
                        )

    else:

        st.markdown(
            topic["notes"]
        )

        st.divider()

        if st.button(
            "🔄 Regenerate Notes",
            use_container_width=True
        ):

            with st.spinner(
                "Creating a fresh explanation..."
            ):

                try:

                    notes = generate_notes(
                        topic["name"],
                        chapter["subject"]
                    )

                    topic["notes"] = notes

                    st.rerun()

                except Exception as e:

                    st.error(
                        f"Something went wrong: {e}"
                    )

    st.divider()

    if st.button(
        "← Back to Chapter",
        use_container_width=True
    ):

        st.session_state.page = "chapter"

        st.rerun()